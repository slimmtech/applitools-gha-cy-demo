{
  "name": "applitools-gha-cy-demo",
  "version": "1.0.0",
  "description": "Applitools Github Integration Demo with Cypress",
  "author": "Mike Millgate",
  "license": "MIT",
  "scripts": {
    "cy:verify": "cypress verify",
    "cy:version": "cypress version",
    "clean:cy:artifacts": "rm -rf cypress/reports cypress/results cypress/screenshots cypress/videos && mkdir cypress/reports cypress/reports/screenshots cypress/reports/videos cypress/results",
    "precy:run": "npm run clean:cy:artifacts",
    "cy:run": "cypress run --browser chrome --env FORCED_FAILURE=$FORCED_FAILURE",
    "cy:open": "cypress open",
    "report:json:merge": "mochawesome-merge cypress/results/json/*.json > cypress/results/test-results.json",
    "report:xml:merge": "jrm cypress/results/test-results.xml 'cypress/results/xml/*.xml'",
    "report:generate": "marge cypress/results/test-results.json -o cypress/reports/html",
    "postcy:run": "npm run report:json:merge && npm run report:xml:merge && npm run report:generate",
    "cy:test": "npm run cy:run || npm run postcy:run",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "format": "npx prettier --write .",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slimmtech/applitools-gha-cy-demo.git"
  },
  "bugs": {
    "url": "https://github.com/slimmtech/applitools-gha-cy-demo/issues"
  },
  "homepage": "https://github.com/slimmtech/applitools-gha-cy-demo/#readme",
  "dependencies": {
    "@applitools/eyes-cypress": "3.58.3",
    "cypress": "15.10.0",
    "cypress-multi-reporters": "2.0.5",
    "eslint": "10.0.0",
    "husky": "9.1.7",
    "junit-report-merger": "9.0.3",
    "lint-staged": "16.2.7",
    "mocha-junit-reporter": "2.2.1",
    "mochawesome": "7.1.4",
    "mochawesome-merge": "5.1.1",
    "mochawesome-report-generator": "6.3.2",
    "prettier": "3.8.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
